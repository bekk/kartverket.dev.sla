# Kopier til backstage-db.env (gitignorert) og fyll inn passordet.
# Blir Secret-en secret-backstage-db i ns-backstage, som appen leser via envFrom.

POSTGRES_HOST=service-backstage-postgres.ns-backstage-db.svc.cluster.local
POSTGRES_PORT=5432
POSTGRES_USER=backstage
POSTGRES_DB=backstage

# Samme verdi som APP_DB_PASSWORD i postgres.env.
POSTGRES_PASSWORD=
