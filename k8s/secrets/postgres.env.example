# Kopier til postgres.env (gitignorert) og fyll inn. Se «Secrets» i k8s/README.md.
# Generer passord: openssl rand -hex 24

# Superbrukeren i instansen. Skal ikke gis til applikasjonen.
POSTGRES_PASSWORD=

# Passordet til rollen «backstage». Brukes av init-SQL-en, og samme verdi
# settes som POSTGRES_PASSWORD i backstage-db.env.
APP_DB_PASSWORD=