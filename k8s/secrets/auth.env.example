# Samme Entra ID (Azure AD)-app-registrering som brukes til Microsoft-innlogging og til
# service-to-service-kall fra regelrett-schemas- og security-metrics-pluginene. Se
# auth.providers.microsoft.production i app-config.production.yaml for det ekte oppsettet
# — her brukes samme felt, bare under auth.providers.microsoft.development.

ENTRA_TENANT_ID=
ENTRA_WEB_APP_ID=
ENTRA_WEB_CLIENT_SECRET=

# Service-principal-en (app-registrering med application-tillatelser mot Microsoft
# Graph, ikke samme som ENTRA_WEB_APP_ID over) som catalog.providers.microsoftGraphOrg
# bruker til å hente User- og Group-entiteter fra Entra ID. Uten disse har catalogen
# ingen brukere å matche mot, og Microsoft-innlogging feiler med
# "NotFoundError: User not found" selv om selve OAuth-utvekslingen lykkes.
ENTRA_ID_SP_APP_ID=
ENTRA_ID_SP_CLIENT_SECRET=

# Regelrett sin egen app-registrerings client-id. Brukes av regelrett-schemas-backend
# til å bygge OAuth-scopet ("<client-id>/.default") den kaller den in-cluster
# regelrett-tjenesten med.
REGELRETT_CLIENT_ID=



SIKKERHETSMETRIKKER_CLIENT_ID=